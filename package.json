{
  "name": "rayshield-demo",
  "version": "1.0.0",
  "description": "RayShield Console demo — Northwind Capital (default) and Straits Meridian Bank (fictional) tenants",
  "main": "index.js",
  "scripts": {
    "build:console": "node scripts/build-console.mjs",
    "build:tenant": "node scripts/gen-canonical.mjs && node scripts/build-tenant-fixtures.mjs",
    "start": "node src/server.js",
    "start:bank": "DEMO_TENANT=straits-meridian node src/server.js",
    "dev": "node src/server.js",
    "validate:tenant": "node scripts/validate-tenant.mjs",
    "check:access": "node scripts/access-check.mjs",
    "check:storyline": "node scripts/storyline-check.mjs",
    "shots:bank": "node scripts/shots-bank.mjs",
    "check:persistence:write": "PHASE=write node scripts/persistence-check.mjs",
    "check:persistence:verify": "PHASE=verify node scripts/persistence-check.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "express": "^4.22.3"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "js-yaml": "^5.4.2",
    "playwright": "^1.47.0"
  }
}
